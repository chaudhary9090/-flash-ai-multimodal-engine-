# Application Settings
APP_NAME="Custom GPT Platform"
ENV="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Security & Secrets (Replace with your strong key in production)
SECRET_KEY="your-jwt-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Paths & Compute Device
DEVICE="cpu" # or "cuda"
MODEL_PATH="app/models/gpt_model.pt"
VOCAB_PATH="app/models/vocab.json"

# Logging & Observability
LOG_LEVEL="INFO"
